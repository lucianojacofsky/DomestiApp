rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: uid, email, name, role, photoURL, phone, location, professionalInfo
    //
    // Collection: services
    // Fields: clientId, professionalId, title, description, status, price, category, images, createdAt, updatedAt
    //
    // Collection: chats
    // Fields: serviceId, participants, lastMessage, updatedAt
    //
    // Collection: transactions
    // Fields: serviceId, clientId, professionalId, amount, status, provider, createdAt
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "lucianojacofsky@gmail.com" && request.auth.token.email_verified == true));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isProfessional() {
      return isAuthenticated() && getUserData().role == 'professional';
    }

    function isClient() {
      return isAuthenticated() && getUserData().role == 'client';
    }

    // Validation helpers
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'role']) &&
             data.uid is string && data.email is string && data.name is string &&
             data.role in ['client', 'professional', 'admin'] &&
             data.name.size() < 100;
    }

    function isValidService(data) {
      return data.keys().hasAll(['clientId', 'title', 'status', 'createdAt']) &&
             data.clientId is string && data.title is string &&
             data.status in ['pending', 'assigned', 'completed', 'cancelled'] &&
             data.title.size() < 200;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || (isClient() && resource.data.role == 'professional'));
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && 
                    (request.resource.data.role != 'admin' || isAdmin());
      allow update: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) &&
                    (request.resource.data.role == resource.data.role || isAdmin());
    }

    match /services/{serviceId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid || 
        resource.data.professionalId == request.auth.uid ||
        (resource.data.status == 'pending' && isProfessional()) ||
        isAdmin()
      );
      allow create: if isClient() && request.resource.data.clientId == request.auth.uid && isValidService(request.resource.data);
      allow update: if isAuthenticated() && (
        (resource.data.clientId == request.auth.uid && request.resource.data.clientId == request.auth.uid) ||
        (resource.data.professionalId == request.auth.uid && request.resource.data.professionalId == request.auth.uid) ||
        (resource.data.status == 'pending' && isProfessional() && request.resource.data.professionalId == request.auth.uid && request.resource.data.status == 'assigned') ||
        isAdmin()
      );
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participants);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants || isAdmin());

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || isAdmin());
        allow create: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) && 
                      request.resource.data.senderId == request.auth.uid;
      }
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid || 
        resource.data.professionalId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isClient() && request.resource.data.clientId == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isClient() && 
                    request.resource.data.clientId == request.auth.uid &&
                    get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.status == 'completed' &&
                    get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.clientId == request.auth.uid;
    }
  }
}
